# =============================================================================
# MongoDB Sharded Cluster — Multi-Host Deployment
# =============================================================================
# Copy this file to .env and customize for your environment.
# Each host runs its own docker-compose file (host1/2/3).

# Host IP addresses (must be reachable from all 3 hosts)
HOST1_IP=10.0.0.1
HOST2_IP=10.0.0.2
HOST3_IP=10.0.0.3

# MongoDB Authentication
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# MongoDB Monitoring User (used by Prometheus exporters)
MONGO_MONITOR_USER=monitor
MONGO_MONITOR_PASSWORD=changeme

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_TIME=01:00
